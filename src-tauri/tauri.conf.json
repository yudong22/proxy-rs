{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Proxy RS",
  "version": "3.5.2",
  "identifier": "com.proxy-rs.desktop",
  "build": {
    "frontendDist": "../ui-dist",
    "beforeBuildCommand": "npm run build:ui",
    "beforeDevCommand": "npm run build:ui -- --watch"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Proxy RS",
        "url": "bootstrap.html",
        "label": "main",
        "width": 920,
        "height": 660,
        "minWidth": 800,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 7, "y": 25.5 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "High-performance AI API proxy to OpenAI-compatible endpoints",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
