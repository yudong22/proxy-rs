# Proxy RS 网关反向代理配置
#
# 当前部署形态（已实测跑通）：
#
#   客户端 ──HTTPS──► Cloudflare ──隧道──► cloudflared ──HTTP──► Caddy:80 ──► 网关:3456
#
# ## 为什么必须走 Cloudflare Tunnel
#
# 域名未完成 ICP 备案。腾讯云在流量到达本机之前就把 80/443 请求劫持到备案
# 拦截页，实测表现为：
#   · 443 的 TLS 握手永远 `read 0 bytes`（云侧设备掐断）；
#   · 源站 Established 计数恒为 0，包根本没到机器；
#   · 安全组开 443 无效（与安全组无关）；
#   · 拦截按 **Host 头** 判定，所以换端口、换子域名都躲不掉。
#
# Cloudflare Tunnel 绕开它的原因：**连接方向反了**。cloudflared 从源站主动
# 外连 Cloudflare 边缘，腾讯云看不到任何入站 80/443 请求，自然无从拦截。
# 源站不需要公网 IP、不需要开放入站端口、不需要证书。
#
# ## 源站为什么只监听 80
#
# TLS 已在 Cloudflare 边缘终结，回源这一段是 CF 骨干网内的 HTTP。源站同时
# 监听 443 没有意义，反而会让 CF 误以为可以 HTTPS 回源而失败（实测会得到
# 521/525 交替）。
#
# ## 备案通过后
#
# 若要改回直连（不经 CF）：删除全局 `auto_https disable_redirects`、删除下面
# 的 `http://` 站点块、取消注释文件末尾的 `gate.wuba.site` 块。届时本机将
# 自动监听 443 并向 Let's Encrypt 申请证书。

# ── 全局选项（必须在任何站点块之前）────────────────────────────────────────
{
	email admin@wuba.site

	# 不自动把 HTTP 308 跳到 HTTPS。CF 已在客户端侧终结 TLS，源站再跳转就是
	# 重定向循环（客户端拿到 https → CF 经隧道回源 80 → 源站又跳 https）。
	#
	# 同时它也让 Caddy 不再尝试为 gate.wuba.site 申请 Let's Encrypt 证书 ——
	# 证书由 Cloudflare 提供，源站不需要，省掉一个 90 天续期的维护点。
	auto_https disable_redirects
}

# ── 隧道回源入口：80 提供完整服务 ──────────────────────────────────────────
# cloudflared 把 CF 边缘的请求以 HTTP 转发到这里。这一段不出公网（隧道是
# 加密的 QUIC/HTTP2），所以不是明文裸奔。
#
# Tunnel 的 Public Hostname 必须配成：Type=HTTP、URL=localhost:80。
# 配成 https:// 会失败 —— 80 上跑的是明文 HTTP，没有 TLS。
http://gate.wuba.site {
	# 观测与管理接口不对外
	@internal path /api/* /metrics /health
	respond @internal 404

	# 首页：使用说明
	handle / {
		root * E:\\proxy-rs\\deploy\\landing
		rewrite * /index.html
		file_server
	}

	# 数据面。flush_interval -1 是 SSE 的关键：不设的话流式响应会被代理层
	# 攒起来，客户端要等全部生成完才收到。
	reverse_proxy /v1/* 127.0.0.1:3456 {
		flush_interval -1
	}
	reverse_proxy /responses 127.0.0.1:3456 {
		flush_interval -1
	}
	reverse_proxy /chat/completions 127.0.0.1:3456 {
		flush_interval -1
	}
	reverse_proxy /backend-api/* 127.0.0.1:3456 {
		flush_interval -1
	}

	# 兜底。matcher 不能省：无 matcher 的 respond 会吃掉所有请求。
	@unknown not path / /v1/* /responses /chat/completions /backend-api/*
	respond @unknown 404
}

# ── 备案通过后启用 ────────────────────────────────────────────────────────
# 删除上面整个 `http://gate.wuba.site` 块与全局的 `auto_https disable_redirects`，
# 本块即自动监听 443 并向 Let's Encrypt 申请证书。
#
# gate.wuba.site {
# 	@internal path /api/* /metrics /health
# 	respond @internal 404
#
# 	handle / {
# 		root * E:\\proxy-rs\\deploy\\landing
# 		rewrite * /index.html
# 		file_server
# 	}
#
# 	reverse_proxy /v1/* 127.0.0.1:3456 {
# 		flush_interval -1
# 	}
# 	reverse_proxy /responses 127.0.0.1:3456 {
# 		flush_interval -1
# 	}
# 	reverse_proxy /chat/completions 127.0.0.1:3456 {
# 		flush_interval -1
# 	}
# 	reverse_proxy /backend-api/* 127.0.0.1:3456 {
# 		flush_interval -1
# 	}
#
# 	log {
# 		output file E:\\proxy-rs\\logs\\caddy-access.log {
# 			roll_size 20MiB
# 			roll_keep 5
# 		}
# 		format console
# 	}
#
# 	@unknown not path / /v1/* /responses /chat/completions /backend-api/*
# 	respond @unknown 404
# }
