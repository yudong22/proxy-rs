# Proxy RS 网关反向代理配置
#
# ACME 邮箱（全局选项，必须写在任何站点块之前）：证书到期提醒发这里。
{
	email admin@wuba.site
}

#
# 职责分工（这里只做"外壳"，不做业务）：
#   · TLS 终止：Caddy 自动向 Let's Encrypt 申请并续期证书，HTTP 自动跳 HTTPS
#   · SSE 不缓冲：flush_interval -1，否则流式响应会被攒成一整块才吐
#   · 边界收窄：只反代 /v1/* 与无需前缀的别名；/api/* 和 /metrics 一律 404
#
# 边界为什么在反代而不是网关里：桌面 GUI 靠本机 fetch 读 /api/*，在网关层
# 加鉴权会把它自己打断。所以网关层只管 /v1/* 的访问 key，观测接口由这里挡。

gate.wuba.site {
	# ── 对外只暴露数据面 ────────────────────────────────────────────────
	# 观测与管理接口不对外。注意这必须在反代规则之前匹配。
	@internal path /api/* /metrics /health
	respond @internal 404

	# ── 首页：使用说明 ──────────────────────────────────────────────────
	# 一个静态页面，告诉拿到密钥的人怎么用。放在这里而不是反代到网关，是因为
	# 网关没有根路径路由（`/` 会掉进它的兜底 404），而这份说明的读者恰恰是
	# 第一次访问、还没有任何客户端配置的人。
	#
	# `file_server` 只服务 /landing 这一个目录，且 `hide` 掉隐藏文件；
	# 不使用 `root` 指向整个磁盘任何位置。
	handle / {
		root * E:\proxy-rs\deploy\landing
		rewrite * /index.html
		file_server {
			hide .git .env
		}
	}

	# ── 数据面：三种客户端协议 ──────────────────────────────────────────
	# flush_interval -1 是 SSE 的关键：等价于 nginx 的 proxy_buffering off。
	# 不设的话，流式响应会被代理层攒起来，客户端只能等到全部生成完才收到，
	# 表现为"卡很久然后一次性吐出来"。
	reverse_proxy /v1/* 127.0.0.1:3456 {
		flush_interval -1
	}

	# 无 /v1 前缀的别名（README 里列出的兼容路径）
	reverse_proxy /responses 127.0.0.1:3456 {
		flush_interval -1
	}
	reverse_proxy /chat/completions 127.0.0.1:3456 {
		flush_interval -1
	}
	reverse_proxy /backend-api/* 127.0.0.1:3456 {
		flush_interval -1
	}

	# ── 超时 ────────────────────────────────────────────────────────────
	# 不设站点级 `timeouts`。Caddy 2.11 的 http.handlers.timeouts 里没有
	# `read_timeout` 一类的子指令，写错会在 `caddy validate` 阶段硬报
	# "unrecognized timeouts subdirective"；而它默认**不设**响应写超时，
	# 恰好是长回复/SSE 需要的行为（网关侧对上游的 read_timeout 是 300s，
	# 见 src-tauri/src/main.rs，反代只要不比它更短即可）。

	# ── 日志 ────────────────────────────────────────────────────────────
	log {
		output file E:\proxy-rs\logs\caddy-access.log {
			roll_size 20MiB
			roll_keep 5
		}
		format console
	}

	# 兜底：除上面明确列出的路径，其余一律 404，不暴露任何未知路由。
	#
	# 这里的 matcher 不能省。Caddy 按书写顺序求值，一个没有 matcher 的
	# `respond 404` 会匹配**所有**请求并立即返回 —— 放在 reverse_proxy 之后
	# 也不例外，因为 reverse_proxy 只对自身 matcher 命中的请求生效，其余请求
	# 继续往下走就撞到这个兜底。症状是所有路径（含 /v1/models）都 404，
	# 看起来像反代没配好，实际是兜底把一切吃掉了。
	#
	# 负向匹配：凡不是数据面路径的，才 404。
	@unknown not path / /v1/* /responses /chat/completions /backend-api/*
	respond @unknown 404
}
